# Application
NEXT_PUBLIC_SITE_URL=https://homeservices.simvix.com
NEXT_PUBLIC_SITE_NAME="Simvix Home Services"
# Contacto público (web, JSON-LD, llms.txt). Sin definir, se usa el teléfono real de src/lib/site.ts.
# NEXT_PUBLIC_CONTACT_PHONE="+34 711 526 127"
# NEXT_PUBLIC_CONTACT_EMAIL=hola@simvix.com
# NEXT_PUBLIC_WHATSAPP=34711526127

# Contact form / Email service
# RESEND_API_KEY=re_xxxxxxxxxxxxxx
# CONTACT_EMAIL=hola@simvix.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Brain (simvix-brain): telemetría de las automatizaciones con IA y envío de cada
# lead del formulario a POST /api/eventos (tipo `contacto`, clave `lead-<id>`, ADR 0011).
# Opcional: sin estas dos variables el servicio no informa nada y funciona igual; los
# leads quedan en el outbox (tabla BrainOutbox) y salen en cuanto se configuren.
# El token lo da el conector del servicio en Brain (Automatizaciones → Conectores)
# y se muestra una sola vez. En Railway se ponen en el servicio `simvix-homeservices`.
# BRAIN_URL=https://simvix-brain-production.up.railway.app
# BRAIN_TOKEN=sb_xxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Módulo /obras (orquestación IA cliente → ayuntamiento)
# ----------------------------------------------------------------------------

# Database: PostgreSQL (ADR 0007). En local, por ejemplo:
#   docker run -d --name simvix-pg -p 5432:5432 -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=simvix postgres:16
#   npm run db:migrate
# En Railway es una referencia al servicio Postgres-Mn3R: ${{Postgres-Mn3R.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:dev@localhost:5432/simvix?schema=public"
# /obras solo se sirve con OBRAS_HABILITADO=true (además de DATABASE_URL). Por defecto apagado.
# OBRAS_HABILITADO=true

# Anthropic Claude API
ANTHROPIC_API_KEY=
# Modelo por defecto del orquestador (override por agente con OBRAS_AGENT_MODEL_<NOMBRE>)
OBRAS_DEFAULT_MODEL=claude-opus-4-7
# Si está vacío, los agentes usan respuestas mock deterministas (útil para dev/CI).
OBRAS_AI_MODE=auto  # auto | live | mock

# Storage de PDFs y adjuntos generados (ruta relativa al root del proyecto)
OBRAS_STORAGE_PATH=./storage

# Identidad del estudio / firma que aparece en documentos generados
OBRAS_FIRMA_NOMBRE="Simvix Arquitectura"
OBRAS_FIRMA_COLEGIADO=""
OBRAS_FIRMA_CIF=""
OBRAS_FIRMA_DIRECCION=""
OBRAS_FIRMA_EMAIL="proyectos@simvix.com"
OBRAS_FIRMA_TELEFONO=""

# Ayuntamientos soportados (CSV de slugs configurados en src/lib/obras/ayuntamientos)
OBRAS_AYUNTAMIENTOS_HABILITADOS="madrid,barcelona,valencia,sevilla,generico"

# ----------------------------------------------------------------------------
# P01 — Persistencia avanzada
# ----------------------------------------------------------------------------

# Clave maestra para encriptación at-rest de PII (Client.dni, address, phone y los datos de Lead).
# Genera 32 bytes en base64 con:  openssl rand -base64 32
# Si no se define, en dev se deriva de NEXTAUTH_SECRET o un fallback. En
# producción es obligatoria.
OBRAS_FIELD_KEY=

# Umbral en ms para considerar una query Prisma como lenta (log warn).
OBRAS_SLOW_QUERY_MS=500

# ----------------------------------------------------------------------------
# P02 — Auth & RBAC
# ----------------------------------------------------------------------------

# NextAuth v5 (Auth.js): secret + URL pública del sitio.
AUTH_SECRET=
# AUTH_URL=http://localhost:3000  # autodetectado en dev
# AUTH_TRUST_HOST=true             # poner a true si despliegas detrás de proxy

# Anti-bruteforce: nº máx. de intentos fallidos antes de bloquear y minutos de bloqueo
OBRAS_MAX_FAILED_LOGINS=5
OBRAS_LOCK_MINUTES=15

# Rondas bcrypt para hash de contraseñas (12 = ~250ms en CPU moderna)
OBRAS_BCRYPT_ROUNDS=12

# Centralización de contactos (ADR 0010)
# RESEND_API_KEY=re_xxxxxxxxxxxxxx            # activa el aviso por correo de cada lead
# LEADS_NOTIFY_EMAIL=jorge.alferez.adan@gmail.com
# LEADS_FROM_EMAIL="Simvix Leads <leads@simvix.com>"  # remitente verificado en Resend
# LEADS_HUB_URL=https://<panel-central>/api/leads     # panel central antiguo (opcional); el central es Brain (BRAIN_URL)
# LEADS_HUB_TOKEN=xxxxxxxx
