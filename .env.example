# Application
NEXT_PUBLIC_SITE_URL=https://homeservices.simvix.com
NEXT_PUBLIC_SITE_NAME="Simvix Home Services"

# Contact form / Email service
# RESEND_API_KEY=re_xxxxxxxxxxxxxx
# CONTACT_EMAIL=hola@simvix.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------------------
# Módulo /obras (orquestación IA cliente → ayuntamiento)
# ----------------------------------------------------------------------------

# Database (SQLite local por defecto, Postgres en producción)
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/simvix_obras?schema=public"

# Anthropic Claude API
ANTHROPIC_API_KEY=
# Modelo por defecto del orquestador (override por agente con OBRAS_AGENT_MODEL_<NOMBRE>)
OBRAS_DEFAULT_MODEL=claude-opus-4-7
# Si está vacío, los agentes usan respuestas mock deterministas (útil para dev/CI).
OBRAS_AI_MODE=auto  # auto | live | mock

# Storage de PDFs y adjuntos generados (ruta relativa al root del proyecto)
OBRAS_STORAGE_PATH=./storage

# Identidad del estudio / firma que aparece en documentos generados
OBRAS_FIRMA_NOMBRE="Simvix Arquitectura"
OBRAS_FIRMA_COLEGIADO=""
OBRAS_FIRMA_CIF=""
OBRAS_FIRMA_DIRECCION=""
OBRAS_FIRMA_EMAIL="proyectos@simvix.com"
OBRAS_FIRMA_TELEFONO=""

# Ayuntamientos soportados (CSV de slugs configurados en src/lib/obras/ayuntamientos)
OBRAS_AYUNTAMIENTOS_HABILITADOS="madrid,barcelona,valencia,sevilla,generico"
