// Simvix Obras — esquema del orquestador IA cliente → ayuntamiento
//
// Provider sqlite por defecto (zero-config). Para producción basta cambiar a
// "postgresql" y la DATABASE_URL. Los enums de dominio están modelados como
// String + constantes TS (src/lib/obras/enums.ts) para mantener portabilidad
// entre providers (SQLite no soporta enums Prisma).
//
// P01 — Persistencia avanzada:
//   - Multi-tenant: Organization + OrganizationMember, orgId opcional en
//     Client/Project (resuelto a la org "default" cuando se omite, para no
//     romper compat con el modo unipersonal del P00).
//   - Soft-delete: campo `deletedAt` en entidades de proyecto.
//   - Auditoría granular: ProjectAudit.
//   - Índices compuestos en TaskRun y ProjectEvent (consultas frecuentes).
//   - Constraints lógicas: aplicadas en código (SQLite no soporta CHECK
//     completos vía Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & RBAC (P02) — modelos compatibles con NextAuth v5 + extras de
// negocio (passwordHash para credentials provider, lastLoginAt, locked).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Credentials provider
  passwordHash  String?

  // Anti-bruteforce
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastLoginAt   DateTime?

  // Rol global (admin de plataforma). Roles por-org en OrganizationMember.
  isPlatformAdmin Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  memberships   OrganizationMember[]
  apiTokens     ApiToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// API tokens para integraciones externas (scope-based).
model ApiToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  tokenHash String   @unique // bcrypt del token; el plaintext sólo se muestra una vez
  scopes    String   // CSV de scopes (projects:read, projects:write, ...)
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Multi-tenant
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug      String   @unique // "default", "estudio-perez", ...
  name      String
  // JSON con preferencias visuales, firma, etc.
  settingsJson String?

  // Cuotas (null = sin límite)
  maxProjects        Int?
  maxAiTokensMonthly Int?
  maxStorageMb       Int?

  // Métricas acumuladas (rolling window mensual gestionado por housekeeping)
  aiTokensMonthly Int   @default(0)
  aiCostUsdTotal  Float @default(0)

  members  OrganizationMember[]
  clients  Client[]
  projects Project[]

  deletedAt DateTime?

  @@index([slug])
}

model OrganizationMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   String // OWNER | ADMIN | ARCHITECT | TECHNICIAN | EXTERNAL | VIEWER

  @@unique([orgId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cliente y proyecto
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  fullName String
  // Campos que pueden ir cifrados (AES-256-GCM, formato "enc:v1:<b64>")
  email    String
  phone    String?
  dni      String?
  address  String?

  deletedAt DateTime?

  projects Project[]

  @@index([orgId])
  @@index([email])
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  reference String  @unique
  title     String
  summary   String?

  addressLine String?
  city        String?
  province    String?
  postalCode  String?
  cadastralId String?

  obraType    String // ObraType enum
  useType     String // UseType
  surfaceM2   Float?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  status       String @default("DRAFT")          // ProjectStatus
  currentPhase String @default("INTAKE")         // PhaseType

  ayuntamientoSlug String?

  aiCostUsd      Float @default(0)
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)

  deletedAt DateTime?

  phases        Phase[]
  documents     Document[]
  conversations Conversation[]
  taskRuns      TaskRun[]
  submissions   Submission[]
  budgetItems   BudgetItem[]
  drawings      Drawing[]
  events        ProjectEvent[]
  audits        ProjectAudit[]

  @@index([orgId])
  @@index([clientId])
  @@index([status])
  @@index([currentPhase])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Fases del workflow
// ---------------------------------------------------------------------------

model Phase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type   String  // PhaseType
  status String  @default("PENDING") // PhaseStatus
  order  Int

  startedAt   DateTime?
  completedAt DateTime?

  resultJson String?
  notes      String?

  @@unique([projectId, type])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Conversaciones (intake y chat por fase)
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agent   String
  role    String
  content String

  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  model        String?

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Documentos
// ---------------------------------------------------------------------------

model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type    String // DocumentType
  title   String
  content String
  format  String @default("MARKDOWN") // DocumentFormat

  filePath String?
  fileSize Int?
  mimeType String?

  version Int @default(1)

  generatedByAi   Boolean @default(false)
  reviewedByHuman Boolean @default(false)
  reviewerNote    String?

  deletedAt DateTime?

  feedbacks DocumentFeedback[]

  @@index([projectId, type])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Presupuesto: capítulos y partidas
// ---------------------------------------------------------------------------

model BudgetItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapter     String
  code        String
  description String
  unit        String
  quantity    Float
  unitPrice   Float
  total       Float

  source String?

  /// Trazabilidad al catálogo de precios (P07). slug del catálogo + código.
  catalogSlug     String?
  catalogItemCode String?

  deletedAt DateTime?

  @@index([projectId, chapter])
  @@index([deletedAt])
  @@index([catalogSlug, catalogItemCode])
}

// ---------------------------------------------------------------------------
// Planos (con storage P05)
// ---------------------------------------------------------------------------

model Drawing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code          String
  title         String
  scale         String?
  category      String // DrawingCategory
  filePath      String?
  thumbnailPath String?
  originalName  String?
  mimeType      String?
  sizeBytes     Int?
  sha256        String?
  uploadedBy    String?

  aiAnnotationsJson String?

  deletedAt DateTime?

  analyses DrawingAnalysis[]

  @@index([projectId])
  @@index([deletedAt])
  @@index([sha256])
}

/// Análisis IA de un plano (visión multimodal) — P06.
model DrawingAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  // Tipo de análisis solicitado: GENERAL | SUPERFICIES | DB_SUA | DB_SI | DISCREPANCIAS
  kind String

  // Resultado estructurado (JSON serializado)
  resultJson String

  // Métricas y trazabilidad
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int?
  status       String @default("SUCCEEDED") // SUCCEEDED | FAILED
  error        String?

  // Si se comparó con otro plano (para discrepancias)
  comparedWithDrawingId String?

  @@index([drawingId, createdAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Ejecuciones de agentes IA
// ---------------------------------------------------------------------------

model TaskRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agent  String
  phase  String? // PhaseType
  status String  @default("RUNNING") // TaskStatus

  input  String
  output String?
  error  String?

  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int?

  @@index([projectId, agent])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Presentación al ayuntamiento
// ---------------------------------------------------------------------------

model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ayuntamientoSlug String
  channel          String @default("REGISTRO_TELEMATICO") // SubmissionChannel
  status           String @default("PREPARED")            // SubmissionStatus

  registroEntrada   String?
  fechaPresentacion DateTime?
  fechaResolucion   DateTime?

  packagePdfPath String?
  cheksum        String?

  responseNotes String?

  deletedAt DateTime?

  @@index([projectId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Eventos / auditoría
// ---------------------------------------------------------------------------

model ProjectEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type    String
  payload String
  actor   String?

  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

// Auditoría granular a nivel de campo. Cada cambio relevante en Project crea
// una fila. P02 podrá colgar también cambios de Client/Document.
model ProjectAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actor  String
  action String // CREATE | UPDATE | SOFT_DELETE | RESTORE | ...
  field  String? // null cuando es un evento global del registro
  before String?
  after  String?

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Plantillas de prompts (versionadas, auditables) — P04
// ---------------------------------------------------------------------------

model PromptTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identificador estable del agente o uso (intake, normativa, chat, ...)
  agentName String   @unique

  // Versión activa actualmente (referenciada por el orquestador)
  activeVersion Int @default(1)

  // Notas humanas
  description String?

  versions PromptTemplateVersion[]
}

model PromptTemplateVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  templateId String
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version Int
  body    String // El system prompt en sí
  author  String? // userId que lo creó

  // Métricas tras canary (rellenadas por evaluación humana o automática)
  totalUses        Int   @default(0)
  thumbsUp         Int   @default(0)
  thumbsDown       Int   @default(0)
  avgCostUsd       Float @default(0)
  avgOutputTokens  Int   @default(0)

  notes String?

  @@unique([templateId, version])
}

// ---------------------------------------------------------------------------
// Feedback humano sobre documentos generados — P04
// ---------------------------------------------------------------------------

model DocumentFeedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String
  rating String // UP | DOWN
  reason String? // razón corta opcional

  @@index([documentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catálogo de precios (CYPE / BEDEC / propio) — P07
// ---------------------------------------------------------------------------

model PriceCatalog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Slug único: cype-2026, bedec-2026, propio-acme, ...
  slug   String  @unique
  name   String
  source String  // "CYPE" | "BEDEC" | "PROPIO" | "OTRO"
  region String? // opcional para precios localizados
  year   Int?
  active Boolean @default(true)

  /// Multi-tenant: null = catálogo público (compartido entre organizaciones).
  /// Si tiene orgId, sólo lo ve esa organización (catálogos propios).
  orgId String?

  /// Notas del importador: path origen, sha256, total items.
  importNotes String?

  items PriceCatalogItem[]

  @@index([orgId])
}

model PriceCatalogItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  catalogId String
  catalog   PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  chapter         String  // ej. "01 Demoliciones"
  code            String  // ej. "01.01.005"
  description     String
  longDescription String?
  unit            String  // m2, m3, ud, h, pa, kg
  unitPrice       Float
  /// Versión del precio: AAAA-MM o similar para auditoría.
  priceVersion    String?

  /// Tokenización barata para búsqueda LIKE/contains (lowercase + sin acentos).
  searchKey String

  @@unique([catalogId, code])
  @@index([catalogId, chapter])
  @@index([searchKey])
}

// ---------------------------------------------------------------------------
// Plantillas de normativa
// ---------------------------------------------------------------------------

model RegulationTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  scope     String
  region    String?
  obraTypes String
  body      String
  source    String?
  version   String?
  updatedAt DateTime @updatedAt
}
