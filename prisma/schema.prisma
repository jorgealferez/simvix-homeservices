// Simvix Obras — esquema del orquestador IA cliente → ayuntamiento
//
// Provider sqlite por defecto (zero-config). Para producción basta cambiar a
// "postgresql" y la DATABASE_URL. Los enums de dominio están modelados como
// String + constantes TS (src/lib/obras/enums.ts) para mantener portabilidad
// entre providers (SQLite no soporta enums Prisma).
//
// P01 — Persistencia avanzada:
//   - Multi-tenant: Organization + OrganizationMember, orgId opcional en
//     Client/Project (resuelto a la org "default" cuando se omite, para no
//     romper compat con el modo unipersonal del P00).
//   - Soft-delete: campo `deletedAt` en entidades de proyecto.
//   - Auditoría granular: ProjectAudit.
//   - Índices compuestos en TaskRun y ProjectEvent (consultas frecuentes).
//   - Constraints lógicas: aplicadas en código (SQLite no soporta CHECK
//     completos vía Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug      String   @unique // "default", "estudio-perez", ...
  name      String
  // JSON con preferencias visuales, firma, etc.
  settingsJson String?

  // Cuotas (null = sin límite)
  maxProjects        Int?
  maxAiTokensMonthly Int?
  maxStorageMb       Int?

  // Métricas acumuladas (rolling window mensual gestionado por housekeeping)
  aiTokensMonthly Int   @default(0)
  aiCostUsdTotal  Float @default(0)

  members  OrganizationMember[]
  clients  Client[]
  projects Project[]

  deletedAt DateTime?

  @@index([slug])
}

model OrganizationMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // userId apunta a un User externo (NextAuth lo introducirá en P02). De
  // momento lo dejamos como string libre para permitir invitaciones por email.
  userId String
  role   String // OWNER | ADMIN | ARCHITECT | TECHNICIAN | EXTERNAL | VIEWER

  @@unique([orgId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cliente y proyecto
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  fullName String
  // Campos que pueden ir cifrados (AES-256-GCM, formato "enc:v1:<b64>")
  email    String
  phone    String?
  dni      String?
  address  String?

  deletedAt DateTime?

  projects Project[]

  @@index([orgId])
  @@index([email])
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  reference String  @unique
  title     String
  summary   String?

  addressLine String?
  city        String?
  province    String?
  postalCode  String?
  cadastralId String?

  obraType    String // ObraType enum
  useType     String // UseType
  surfaceM2   Float?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  status       String @default("DRAFT")          // ProjectStatus
  currentPhase String @default("INTAKE")         // PhaseType

  ayuntamientoSlug String?

  aiCostUsd      Float @default(0)
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)

  deletedAt DateTime?

  phases        Phase[]
  documents     Document[]
  conversations Conversation[]
  taskRuns      TaskRun[]
  submissions   Submission[]
  budgetItems   BudgetItem[]
  drawings      Drawing[]
  events        ProjectEvent[]
  audits        ProjectAudit[]

  @@index([orgId])
  @@index([clientId])
  @@index([status])
  @@index([currentPhase])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Fases del workflow
// ---------------------------------------------------------------------------

model Phase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type   String  // PhaseType
  status String  @default("PENDING") // PhaseStatus
  order  Int

  startedAt   DateTime?
  completedAt DateTime?

  resultJson String?
  notes      String?

  @@unique([projectId, type])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Conversaciones (intake y chat por fase)
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agent   String
  role    String
  content String

  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  model        String?

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Documentos
// ---------------------------------------------------------------------------

model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type    String // DocumentType
  title   String
  content String
  format  String @default("MARKDOWN") // DocumentFormat

  filePath String?
  fileSize Int?
  mimeType String?

  version Int @default(1)

  generatedByAi   Boolean @default(false)
  reviewedByHuman Boolean @default(false)
  reviewerNote    String?

  deletedAt DateTime?

  @@index([projectId, type])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Presupuesto: capítulos y partidas
// ---------------------------------------------------------------------------

model BudgetItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapter     String
  code        String
  description String
  unit        String
  quantity    Float
  unitPrice   Float
  total       Float

  source String?

  deletedAt DateTime?

  @@index([projectId, chapter])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Planos
// ---------------------------------------------------------------------------

model Drawing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code          String
  title         String
  scale         String?
  category      String // DrawingCategory
  filePath      String?
  thumbnailPath String?

  aiAnnotationsJson String?

  deletedAt DateTime?

  @@index([projectId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Ejecuciones de agentes IA
// ---------------------------------------------------------------------------

model TaskRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agent  String
  phase  String? // PhaseType
  status String  @default("RUNNING") // TaskStatus

  input  String
  output String?
  error  String?

  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int?

  @@index([projectId, agent])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Presentación al ayuntamiento
// ---------------------------------------------------------------------------

model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ayuntamientoSlug String
  channel          String @default("REGISTRO_TELEMATICO") // SubmissionChannel
  status           String @default("PREPARED")            // SubmissionStatus

  registroEntrada   String?
  fechaPresentacion DateTime?
  fechaResolucion   DateTime?

  packagePdfPath String?
  cheksum        String?

  responseNotes String?

  deletedAt DateTime?

  @@index([projectId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Eventos / auditoría
// ---------------------------------------------------------------------------

model ProjectEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type    String
  payload String
  actor   String?

  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

// Auditoría granular a nivel de campo. Cada cambio relevante en Project crea
// una fila. P02 podrá colgar también cambios de Client/Document.
model ProjectAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actor  String
  action String // CREATE | UPDATE | SOFT_DELETE | RESTORE | ...
  field  String? // null cuando es un evento global del registro
  before String?
  after  String?

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Plantillas de normativa
// ---------------------------------------------------------------------------

model RegulationTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  scope     String
  region    String?
  obraTypes String
  body      String
  source    String?
  version   String?
  updatedAt DateTime @updatedAt
}
